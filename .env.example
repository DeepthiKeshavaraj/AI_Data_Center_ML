# ==============================================================================
# AI DATA CENTER MANAGEMENT - ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================
# Copy this file to .env and fill in your actual production/deployment credentials.
# WARNING: NEVER COMMIT REAL SECRETS OR MONGODB_URI TO VERSION CONTROL!
# ==============================================================================

# --- MongoDB Atlas Connection ---
# Obtain from MongoDB Atlas -> Connect -> Connect your application -> Driver (Python)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=ai_datacenter_ml

# --- Environment & Security ---
# Set to 'production' for HTTPS Secure cookies, or 'development' for local HTTP
ENVIRONMENT=development

# --- CORS & Networking ---
# Comma-separated list of allowed frontend client origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend-domain.vercel.app

# Server binding host and port
HOST=0.0.0.0
PORT=8000

# --- Frontend Deployment Variable (Vite) ---
# Set this in your frontend hosting environment (e.g., Vercel, Netlify, Render)
# Points to the deployed backend API URL
VITE_API_BASE_URL=/api
